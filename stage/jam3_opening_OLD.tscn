text = "Voting"

[node name="Body" parent="Slides/Slide4" index="4"]
text = "> Overall winner
> Category winners
 * Presentation: look, sound, feel
 * Gameplay: unique, engaging
 * Enjoyment: was it fun?
> Starts after submissions close
> Ends during the closing ceremony"

