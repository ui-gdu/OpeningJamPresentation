[node name="Header" parent="Slides/Slide10" index="3"]
text = "Groups"

[node name="Body" parent="Slides/Slide10" index="4"]
text = "> Mingle and find your group.
> No more than 4 per a group.

> Most importantly, have fun!"

[node name="Slide7" parent="Slides" instance=ExtResource("4_cxybx")]
offset_left = -960.0
