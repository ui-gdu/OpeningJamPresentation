[node name="Header" parent="Slides/Slide7" index="3"]
text = "What to Expect"

[node name="Body" parent="Slides/Slide7" index="4"]
text = "> Learning
> Teamwork
> Friendship
> Goodies

> Professionally applicable skills"

[node name="Slide6" parent="Slides" instance=ExtResource("4_cxybx")]
offset_left = -480.0
offset_bottom = 270.0

[node name="Header" parent="Slides/Slide6" index="3"]
text = "Rules"

[node name="Body" parent="Slides/Slide6" index="4"]
text = "> No NSFW content
> No malware
> No politics
> No inappropriate portrayals
  of university staff
> Swearing is discouraged



Generally: If we can’t present your game to our faculty advisor comfortably, your game will be disqualified"

[node name="Slide5" parent="Slides" instance=ExtResource("4_cxybx")]
offset_left = 1440.0
offset_right = 1920.0
offset_bottom = 270.0

